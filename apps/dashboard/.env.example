# Set to true to replace dashboard pages with the shared maintenance notice.
MAINTENANCE_MODE=false

# Auth.js (next-auth v5) — https://authjs.dev/getting-started/deployment
# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=

# GitHub OAuth app credentials — https://github.com/settings/developers
# Callback URL: <origin>/api/auth/callback/github (e.g. http://localhost:3001/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Cloudflare D1 (SQLite) accessed over the D1 HTTP API. When all three are set
# the dashboard reads registry data from D1 (kept current by the sync workflow
# POSTing to /api/registry/events). When any is unset, it falls back to reading
# the is-pinoy-dev/domains repo via the GitHub API.
# Create the DB with: pnpm dlx wrangler d1 create dashboard-db
# Apply the schema with: pnpm --filter dashboard db:migrate
# Check all three with: pnpm --filter dashboard db:check
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# API token scoped to D1:Edit — https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_D1_API_TOKEN=

# Cloudflare Email Routing, accessed over its account-scoped REST API. Backs
# the Contact Form feature's "Verify email" action (lib/cloudflare-email.ts):
# registering and checking an owner's address as a verified destination
# before the dashboard will let them switch the feature on. Reuses the
# CLOUDFLARE_ACCOUNT_ID above — this is account-scoped, not zone-scoped, so
# CLOUDFLARE_ZONE_ID plays no part here. When unset, the "Verify email"
# action and status check are unavailable and the switch stays disabled.
# API token scoped to Account -> Email Routing Addresses -> Edit —
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_EMAIL_API_TOKEN=

# Shared secret for POST /api/registry/events. Generate with:
# openssl rand -hex 32 — set the same value in the domains repo's Actions
# secrets so the sync workflow can authenticate.
REGISTRY_SYNC_SECRET=

# Trusted portfolio screenshot Worker. The secret is server-only and must
# match the Worker's SCREENSHOT_WORKER_SECRET secret binding.
SCREENSHOT_WORKER_URL=https://screenshots-api.is-pinoy.dev
SCREENSHOT_WORKER_SECRET=
PORTFOLIO_SCREENSHOT_MANUAL_COOLDOWN_HOURS=24

# Optional: raises the unauthenticated GitHub API rate limit when listing
# registry subdomains in the no-database fallback. Works without it.
GITHUB_TOKEN=

# Origin of the portfolio renderer (apps/portfolio), used to build the "Preview"
# links on /claim. Defaults to https://portfolio.is-pinoy.dev. Point it at the
# local renderer when developing the claim flow, otherwise every Preview link
# opens production:
#   NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:3002
NEXT_PUBLIC_PORTFOLIO_URL=

# Feature flags (lib/flags.ts + lib/flags-server.ts). All server-side only —
# none of this is ever sent to the browser. Each flag declares the environments
# it is on in; the settings below override that.
#
# Vercel Flags SDK key (`vf_server_...`) — see lib/flags.ts. Feature flags are
# managed in Vercel Flags; every targeting rule lives in the Vercel dashboard,
# not in this repo.
#
# NOT needed on Vercel. Deployments carry VERCEL_OIDC_TOKEN, and the client
# authenticates with it, taking the project from the token's project_id claim.
# Set this only where OIDC is unavailable: outside Vercel, or locally if you are
# not using `vercel dev`.
#
# Deliberately left commented out rather than blank. @vercel/flags-core only
# validates the key when it is *defined*, so an empty FLAGS= throws
# "Missing sdkKey" and every flag reads false, while an absent one falls through
# to OIDC. Blank is worse than missing — uncomment only to set a real value.
#
# Prefer pulling it over pasting it, and never commit it:
#   pnpm dlx vercel env pull .env.local
# FLAGS=

# Signs requests from the Vercel Toolbar to /.well-known/vercel/flags, which
# lets you list the flags and override them for your own browser. Optional —
# without it that endpoint refuses requests and flags still resolve normally.
# Generate with: openssl rand -base64 32
FLAGS_SECRET=

