# Auth.js (next-auth v5) — https://authjs.dev/getting-started/deployment
# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=

# GitHub OAuth app credentials — https://github.com/settings/developers
# Callback URL: <origin>/api/auth/callback/github (e.g. http://localhost:3001/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Cloudflare D1 (SQLite) accessed over the D1 HTTP API. When all three are set
# the dashboard reads registry data from D1 (kept current by the sync workflow
# POSTing to /api/registry/events). When any is unset, it falls back to reading
# the is-pinoy-dev/domains repo via the GitHub API.
# Create the DB with: pnpm dlx wrangler d1 create dashboard-db
# Apply the schema with: pnpm --filter dashboard db:migrate
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# API token scoped to D1:Edit — https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_D1_API_TOKEN=

# Shared secret for POST /api/registry/events. Generate with:
# openssl rand -hex 32 — set the same value in the domains repo's Actions
# secrets so the sync workflow can authenticate.
REGISTRY_SYNC_SECRET=

# Optional: raises the unauthenticated GitHub API rate limit when listing
# registry subdomains in the no-database fallback. Works without it.
GITHUB_TOKEN=

# Origin of the portfolio renderer (apps/portfolio), used to build the "Preview"
# links on /claim. Defaults to https://portfolio.is-pinoy.dev. Point it at the
# local renderer when developing the claim flow, otherwise every Preview link
# opens production:
#   NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:3002
NEXT_PUBLIC_PORTFOLIO_URL=

# Feature flags (lib/flags.ts + lib/flags-server.ts). All server-side only —
# none of this is ever sent to the browser. Each flag declares the environments
# it is on in; the settings below override that.
#
# Vercel Flags connection string. Set automatically on Vercel once the project
# is connected to Vercel Flags — you should not need to fill this in by hand.
# When it is present the flags resolve against Vercel Flags, and the targeting
# rules live in the Vercel dashboard rather than in this repo.
#
# Leave it unset locally: without it the app falls back to the two variables at
# the bottom of this block, so `pnpm dev`, CI, and `next start` work with no
# Vercel connection and spend no flag-request quota.
FLAGS=

# Signs requests from the Vercel Toolbar to /.well-known/vercel/flags, which
# lets you list the flags and override them for your own browser. Optional —
# without it that endpoint refuses requests and flags still resolve normally.
# Generate with: openssl rand -base64 32
FLAGS_SECRET=

# Off-Vercel fallback, used only when FLAGS is unset. Lets you switch a flag on
# locally without touching production config.
#
#   DASHBOARD_FLAGS           explicit per-flag on/off, comma-separated, as
#                             `claim=on` / `claim=off` (a bare `claim` means
#                             on). Highest precedence. Unknown names ignored.
#   DASHBOARD_FLAG_TESTERS    GitHub logins that see every not-yet-launched
#                             flag. Comma-separated, case-insensitive.
DASHBOARD_FLAGS=
DASHBOARD_FLAG_TESTERS=

