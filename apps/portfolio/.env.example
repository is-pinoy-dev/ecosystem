# GitHub API token. STRONGLY RECOMMENDED — effectively required in production.
# Every render costs 3 API calls (/users, /users/:u/repos, /repos/:u/:u/readme),
# so the 60 req/hr anonymous ceiling is exhausted by ~20 page views per hour.
# Past the limit the renderer degrades to a clean 404, i.e. the whole page is
# gone. Needs no scopes at all — a classic token with zero boxes checked, or a
# fine-grained token with public read access, is enough.
# GH_TOKEN is accepted as an alias.
GITHUB_TOKEN=

# Apex the renderer strips to find the subdomain label in the Host header.
# Defaults to is-pinoy.dev; override only for a staging apex.
PORTFOLIO_ROOT_DOMAIN=is-pinoy.dev

# Local dev only — the renderer normally derives the subdomain from the Host
# header, which you don't have without wildcard DNS. Set ONE of these to render
# something at http://localhost:3002/ :
#
#   PORTFOLIO_SPIKE_SUBDOMAIN — resolve this subdomain against the domains repo
#     exactly as production would (needs a subdomains/<name>.json with a
#     `portfolio` block on the repo's main branch).
#   PORTFOLIO_SPIKE_LOGIN — skip resolution and render this GitHub login in the
#     terminal template. Useful before any portfolio subdomain exists.
#
# Leave both unset in production, where Host-based routing takes over. Neither
# is needed to exercise a preview URL (/?preview=1&login=…&template=…).
PORTFOLIO_SPIKE_SUBDOMAIN=
PORTFOLIO_SPIKE_LOGIN=
