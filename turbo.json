{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ZONE_ID",
        "DOMAIN",
        "GITHUB_TOKEN",
        "GH_TOKEN",
        "AUTH_SECRET",
        "AUTH_GITHUB_ID",
        "AUTH_GITHUB_SECRET",
        "AUTH_URL",
        "AUTH_TRUST_HOST",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_D1_DATABASE_ID",
        "CLOUDFLARE_D1_API_TOKEN",
        "CLOUDFLARE_ANALYTICS_D1_DATABASE_ID",
        "REGISTRY_SYNC_SECRET",
        "SCREENSHOT_WORKER_URL",
        "SCREENSHOT_WORKER_SECRET",
        "OG_WORKER_ORIGIN",
        "PORTFOLIO_SCREENSHOT_MANUAL_COOLDOWN_HOURS",
        "VERCEL_GIT_COMMIT_SHA",
        "PORTFOLIO_ROOT_DOMAIN",
        "PORTFOLIO_PROXY_SECRET",
        "PORTFOLIO_WORKER",
        "PORTFOLIO_SPIKE_SUBDOMAIN",
        "PORTFOLIO_SPIKE_LOGIN",
        "NEXT_PUBLIC_PORTFOLIO_URL",
        "MAINTENANCE_MODE",
        "FLAGS",
        "FLAGS_SECRET"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
