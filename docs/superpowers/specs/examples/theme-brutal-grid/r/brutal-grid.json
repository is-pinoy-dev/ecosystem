{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "brutal-grid",
  "type": "registry:theme",
  "title": "Brutal Grid",
  "description": "Heavy rules, oversized numerals, a nine-cell work grid. Light only.",
  "author": "Maria Santos <maria@example.dev>",
  "categories": ["portfolio", "brutalist"],

  "cssVars": {
    "theme": {
      "font-sans": "'Helvetica Neue', Arial, sans-serif",
      "font-mono": "'IBM Plex Mono', ui-monospace, monospace"
    },
    "light": {
      "background": "#e8e8e6",
      "foreground": "#0a0a0a",
      "muted-foreground": "#3a3a38",
      "border": "#0a0a0a",
      "primary": "#0a0a0a",
      "primary-foreground": "#e8e8e6"
    }
  },

  "files": [
    {
      "path": "theme.css",
      "type": "registry:file",
      "target": "styles/brutal-grid.css"
    }
  ],

  "meta": {
    "isPinoyDev": {
      "tier": "layout",
      "contract": 1,
      "colorScheme": "light",
      "blocks": [
        { "block": "identity", "variant": "stacked" },
        { "block": "bio" },
        { "block": "meta", "variant": "inline" },
        { "block": "repos", "variant": "grid", "limit": 9 },
        { "block": "readme" },
        { "block": "footer", "variant": "minimal" }
      ]
    }
  }
}
